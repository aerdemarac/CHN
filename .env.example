# ==============================================================================
# CHN (Cyprus Health-Care Network) - Environment Configuration Example
# ------------------------------------------------------------------------------
# USAGE: Copy this file as ".env" or "config/.env" and adjust the values
# according to your local development environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_NAME=Cyprus Health-Care Network
# Environment mode: local, development, or production
APP_ENV=local
# Debug mode: true in development, false in production
APP_DEBUG=true
# Base URL of the project
APP_URL=http://localhost/CHN

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL / PDO Connection)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
# Database name where schema.sql is imported
DB_NAME=chn_db
# Database user (XAMPP default: root)
DB_USER=root
# Database password (XAMPP default: empty)
DB_PASS=
DB_CHARSET=utf8mb4

# ------------------------------------------------------------------------------
# 3. EMAIL SERVICE (PHPMailer / SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=CHN Website

# ------------------------------------------------------------------------------
# 4. AI ASSISTANT (Gemini API - Chatbot)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash-lite

# ------------------------------------------------------------------------------
# 5. SECURITY & SESSION POLICIES (From BACKEND_STRUCTURE_DESIGN.md)
# ------------------------------------------------------------------------------
# Inactivity session timeout in seconds (30 minutes: 30 * 60 = 1800)
SESSION_LIFETIME=1800
# Consecutive failed login attempts before temporary account lockout
LOGIN_MAX_ATTEMPTS=5
# Lockout duration in seconds (15 minutes: 15 * 60 = 900)
LOGIN_LOCKOUT_TIME=900
